; Read by both Dohyo::Loader and named-checkzone, and compared RR by RR (test/interop/test_zonefile.rb).
; Within an RRset every RR has the same TTL: dohyo and BIND settle a mismatch differently.
$ORIGIN sub.example.com.
$TTL 3600

; Parentheses across lines, with a comment at the end of each.
@               IN  SOA   ns1.example.com. hostmaster.example.com. (
                          2026111001 ; serial
                          7200       ; refresh
                          3600       ; retry
                          1209600    ; expire
                          300 )      ; minimum
; The owner, TTL and class carry over from the previous record when they are left out.
                IN  NS    ns1.example.com.
                    NS    ns2.example.com.
@           600 IN  A     192.0.2.1
            600     A     192.0.2.2

; Relative and absolute owner names.
www             IN  A     192.0.2.10
www.sub.example.com. IN AAAA 2001:db8::10
deep.er.name        A     192.0.2.11

; Upper and mixed case in owner names.
MiXeD           IN  A     192.0.2.20
UPPER.Case      IN  A     192.0.2.21

; Identical RRs within an RRset are one RR.
dup             IN  A     192.0.2.30
dup             IN  A     192.0.2.30
dup             IN  A     192.0.2.31

; AAAA written in different ways.
v6              IN  AAAA  2001:DB8::1
v6              IN  AAAA  2001:0db8:0000:0000:0000:0000:0000:0002
v6              IN  AAAA  2001:db8:0:0:0:0:0:3
v6              IN  AAAA  ::ffff:192.0.2.4

; HTTPS: the test vectors of RFC 9460 Appendix D.1 and D.2 whose values have no escapes. The last is written
; without its parentheses, which dns-zonefile does not read in HTTPS (test/test_loader.rb).
alias           IN  HTTPS 0 foo.example.com.
svc1            IN  HTTPS 1 .
svc2            IN  HTTPS 16 foo.example.com. port=53
svc3            IN  HTTPS 1 foo.example.com. key667=hello
svc4            IN  HTTPS 1 foo.example.com. ipv6hint="2001:db8::1,2001:db8::53:1"
svc5            IN  HTTPS 1 example.com. ipv6hint="2001:db8:122:344::192.0.2.33"
svc6            IN  HTTPS 16 foo.example.org. alpn=h2,h3-19 mandatory=ipv4hint,alpn ipv4hint=192.0.2.1
