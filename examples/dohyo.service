# systemd unit for dohyo, deployed as a git checkout in /opt/dohyo with Ruby in /usr/local/ruby-4.0.7.
[Unit]
Description=dohyo authoritative DNS server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dohyo
Group=dohyo
WorkingDirectory=/opt/dohyo
ExecStartPre=/usr/local/ruby-4.0.7/bin/bundle exec exe/dohyo --config /etc/dohyo/dohyo.yml --check
ExecStart=/usr/local/ruby-4.0.7/bin/bundle exec exe/dohyo --config /etc/dohyo/dohyo.yml
ExecReload=/bin/kill -HUP $MAINPID
# Ports 53 and 853 without running as root:
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/dohyo /etc/letsencrypt
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
